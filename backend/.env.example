# Copy to backend/.env. JWT_SECRET and FIELD_ENCRYPTION_KEY are generated automatically on first run.
# Optional: enables Claude-written explanations and messages (otherwise standard templates are used).
ANTHROPIC_API_KEY=
# Optional: real SMS via Twilio (otherwise SMS is simulated and logged).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# 1 = show the dev mailbox page used by "forgot password" in the demo.
DEV_MODE=1
